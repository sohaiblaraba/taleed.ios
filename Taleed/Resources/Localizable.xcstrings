    "auth_finish_expired_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع مجددًا باستخدام Google أو Apple لإنشاء حسابك."
          }
