    "settings_delete_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نهائي. تُمحى بياناتك الشخصية؛ تبقى معاملاتك السابقة مرئية للطرف الآخر دون هويتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanent. Your personal data is erased; your past transactions stay visible to the other party, without your identity."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définitif. Vos données personnelles sont effacées ; vos anciennes transactions restent visibles par l’autre partie, sans votre identité."
          }
        }
      }
    },
