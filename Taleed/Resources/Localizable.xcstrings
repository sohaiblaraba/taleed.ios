      }
    },
    "settings_email_resend_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يصلك بريد التحقق؟ تحقق من مجلد الرسائل غير المرغوب فيها، ثم أعد الإرسال إذا لزم الأمر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Didn’t get the verification email? Check your spam folder, then resend it if needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez pas reçu l’email de vérification ? Regardez dans les spams, puis renvoyez-le si besoin."
          }
        }
      }
    },
    "settings_email_resend_cta": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة إرسال بريد التحقق"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resend verification email"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoyer l’email de vérification"
          }
        }
      }
    },
    "settings_email_resend_sent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إرسال بريد التحقق — لا تنسَ التحقق من الرسائل غير المرغوب فيها."
          }
        },
