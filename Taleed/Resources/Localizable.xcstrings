    "orders_get_shipping_label": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصل الشحن"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shipping label"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bordereau d’expédition"
          }
        }
      }
    },
    "orders_get_shipping_label_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنشأ الوصل ثم يُنزَّل. اطبعه والصقه جيدًا على الطرد، ثم أودعه في أقرب نقطة تجميع أو وكالة. يتم تحديث التتبع تلقائيًا بعد ذلك. المُرسِل المذكور هو Taleed (الحساب التجاري لدى الناقل) — هذا طبيعي: رقم التتبع يربط الطرد بطلبك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The label is generated and downloaded. Print it, stick it flat on the parcel, then drop the parcel at the nearest collection point or agency. Tracking updates automatically afterwards. The sender shown is Taleed (carrier merchant account) — that's expected: the tracking number ties the parcel to your order."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bordereau est généré puis téléchargé. Imprimez-le, collez-le bien à plat sur le colis, puis déposez le colis au point de collecte ou à l’agence la plus proche. Le suivi se met ensuite à jour automatiquement. L’expéditeur mentionné est Taleed (compte marchand du transporteur) — c’est normal : le numéro de suivi lie le colis à votre commande."
          }
        }
      }
    },
    "orders_generate_and_download": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء وتنزيل"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate & download"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Générer et télécharger"
          }
        }
      }
    },
