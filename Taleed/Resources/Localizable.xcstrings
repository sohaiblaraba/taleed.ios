    "app_settings_delete_erased_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يُحذف"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is erased"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est effacé"
          }
        }
      }
    },
    "app_settings_delete_erased_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمك وبريدك الإلكتروني وهاتفك ونبذتك وولايتك وبيانات الفوترة، وصورة ملفك الشخصي، وإعلاناتك التي لم يطلبها أحد وصورها، وعناوينك المحفوظة، ومفضلاتك ومتابعاتك وحظرك، وإشعاراتك، وقسائم الشراء غير المستعملة، ووثائق هويتك، وأجهزتك وكل جلساتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name, email address, phone, bio, wilaya and billing details, your profile photo, the listings nobody ordered and their photos, your saved addresses, your favorites, follows and blocks, your notifications, your unused vouchers, your ID documents, your devices and every session."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nom, votre adresse email, votre téléphone, votre bio, votre wilaya et vos informations de facturation, votre photo de profil, vos annonces que personne n’a commandées et leurs photos, vos adresses enregistrées, vos favoris, abonnements et blocages, vos notifications, vos bons d’achat non utilisés, vos pièces d’identité, vos appareils et toutes vos sessions."
          }
        }
      }
    },
    "app_settings_delete_kept_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يبقى"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What stays"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui reste"
          }
        }
      }
    },
    "app_settings_delete_kept_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى طلباتك وتقييماتك ورسائلك مرئية للأعضاء الآخرين، مع عبارة «حساب محذوف» بدل ملفك الشخصي. وتُسحب الإعلانات التي سبق طلبها من البيع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your orders, reviews and messages stay visible to the other members, shown as a deleted account instead of your profile. Listings that were ordered are taken off sale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos commandes, évaluations et messages restent visibles par les autres membres, avec la mention « compte supprimé » à la place de votre profil. Les annonces déjà commandées sont retirées de la vente."
          }
        }
      }
    },
    "app_settings_delete_irreversible": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحذف نهائي: لا يمكن التراجع عنه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletion is permanent: it can’t be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression est définitive : elle ne peut pas être annulée."
          }
        }
      }
    },
    "app_settings_delete_continue": {
      "extractionState": "manual",
