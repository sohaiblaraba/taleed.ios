    "orders_get_real_shipping_label_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الطلب لديه وصل تجريبي (وضع العرض). سيتم إنشاء طرد حقيقي لدى الناقل ويحل محل القديم — سيتغير رقم التتبع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This order has a test label (demo mode). A real parcel will be created with the carrier and replaces the old one — the tracking number will change."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette commande a un bordereau de test (mode démo). Un vrai bordereau va être créé chez le transporteur et remplacera l’ancien — le numéro de suivi changera."
          }
        }
      }
    },
