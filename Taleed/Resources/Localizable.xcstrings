    "app_error_address_limit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد بلغت الحد الأقصى لعدد العناوين. احذف عنوانًا لإضافة آخر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have reached the maximum number of addresses. Delete one to add another."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint le nombre maximal d’adresses. Supprimez-en une pour en ajouter une autre."
          }
        }
      }
    },
    "app_error_file_too_large": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الصورة كبيرة جدًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo is too large."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo est trop volumineuse."
          }
        }
      }
    },
    "app_error_forbidden": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك القيام بهذا الإجراء."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t do this."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas effectuer cette action."
          }
        }
      }
    },
    "app_error_invalid_request": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من الحقول المشار إليها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the highlighted fields."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les champs indiqués."
          }
        }
      }
    },
    "app_error_invalid_state": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر الوضع في الأثناء. حدّث الصفحة لرؤية الخيارات الجديدة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This has changed in the meantime. Refresh to see what you can do now."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La situation a changé entre-temps. Actualisez pour voir les nouvelles options."
          }
        }
      }
    },
    "app_error_invite_required": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيل في تليد بالدعوة فقط حاليًا. اطلب دعوة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taleed is invite-only for now. Request an invitation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taleed est sur invitation pour le moment. Demandez une invitation."
          }
        }
      }
    },
    "app_error_listing_locked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تعديل هذا الغرض حاليًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item can’t be changed right now."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet article ne peut pas être modifié pour le moment."
          }
        }
      }
    },
    "app_error_offer_closed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد هذا العرض بانتظار رد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This offer is no longer waiting for an answer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette offre n’attend plus de réponse."
          }
        }
      }
