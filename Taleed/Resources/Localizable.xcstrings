    "settings_name_locked_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التحقق من هويتك، لذا يجب أن يبقى اسمك مطابقًا لوثيقة هويتك. اتصل بنا إذا احتاج إلى تصحيح."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your identity is verified, so your name now has to keep matching your ID document. Contact us if it needs correcting."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre identité est vérifiée : votre nom doit désormais rester conforme à votre pièce d’identité. Contactez-nous s’il doit être corrigé."
          }
        }
      }
    },
