    "app_referrals_hero_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادعُ صديقًا — قسائم شراء بقيمة %1$@ لك و%1$@ له"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite a friend — %1$@ in vouchers for you, %1$@ for them"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez un ami — %1$@ de bons d’achat pour vous, %1$@ pour lui"
          }
        }
      }
    },
    "app_referrals_hero_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بمجرد أن ينشر صديقك %1$@، تحصلان معًا على قسيمة شراء بقيمة %2$@ تُخصم من طلب قادم، ثم %#@more@ لكل منكما عندما يحقق أول عملية بيع."
          },
          "substitutions": {
            "more": {
              "argNum": 3,
              "formatSpecifier": "ld",
              "variations": {
                "plural": {
                  "zero": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg قسيمة إضافية بقيمة %2$@"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "قسيمة إضافية واحدة بقيمة %2$@"
                    }
                  },
                  "two": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "قسيمتين إضافيتين بقيمة %2$@"
                    }
                  },
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg قسائم إضافية بقيمة %2$@"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg قسيمة إضافية بقيمة %2$@"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg قسيمة إضافية بقيمة %2$@"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once your friend lists %1$@, you'll both get a %2$@ voucher off a future order, then %#@more@ each when they make a sale."
          },
          "substitutions": {
            "more": {
              "argNum": 3,
              "formatSpecifier": "ld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg more %2$@ voucher"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg more %2$@ vouchers"
                    }
                  }
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès que votre ami publie %1$@, vous recevez chacun un bon d’achat de %2$@, à déduire d’une prochaine commande. Puis %#@more@ de plus chacun lorsqu’il réalise sa première vente."
          },
          "substitutions": {
            "more": {
              "argNum": 3,
              "formatSpecifier": "ld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg bon de %2$@"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg bons de %2$@"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "app_referrals_step2_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا نشر %1$@ خلال %2$@ من انضمامه، تحصلان معًا على قسيمة شراء بقيمة %3$@ تُخصم من طلب قادم. وإذا باع مقالاً خلال أول %4$@، تحصلان معًا على %5$@ بقيمة %3$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once they list %1$@ within %2$@ of joining, you'll both get a %3$@ voucher off a future order. If they sell an item within their first %4$@, you'll both get %5$@ of %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’il publie %1$@ dans les %2$@ suivant son inscription, vous recevez chacun un bon d’achat de %3$@, à déduire d’une prochaine commande. S’il vend un article dans les %4$@ suivant son inscription, vous recevez chacun %5$@ de %3$@."
          }
        }
      }
    },
    "app_referrals_step3_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم خصم قسيمتك تلقائيًا من طلبك التالي بقيمة %@ أو أكثر (لا تشمل الشحن أو رسوم المنصة والخدمة)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voucher will be automatically deducted from your next order of %@ or more (not including shipping or the platform & service fee)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bon est automatiquement déduit de votre prochaine commande de %@ ou plus (hors livraison et frais de plateforme et de service)."
          }
        }
      }
    },
