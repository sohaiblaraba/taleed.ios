      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règles des bons d’achat"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قواعد قسائم الشراء"
