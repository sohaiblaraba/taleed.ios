    "settings_email_change_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إرسال رابط التأكيد إلى العنوان الجديد. لن يحل محل عنوانك الحالي إلا بعد التأكيد — يبقى تسجيل دخولك دون تغيير حتى ذلك الحين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A confirmation link will be sent to the new address. It only replaces your current address once confirmed — your login stays unchanged until then."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien de confirmation sera envoyé à la nouvelle adresse. Elle ne remplacera votre adresse actuelle qu’une fois confirmée — votre identifiant de connexion reste inchangé d’ici là."
          }
        }
      }
    },
    "settings_new_email_label": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
