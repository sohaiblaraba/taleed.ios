    "app_bundle_remove_body": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vendeur a accepté votre offre de %@ pour ce lot. Modifier le lot annule cette offre."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل البائع عرضك بقيمة %@ لهذه الحزمة. تعديل الحزمة يلغي هذا العرض."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The seller accepted your offer of %@ for this bundle. Changing the bundle cancels this offer."
          }
        }
      }
    },
