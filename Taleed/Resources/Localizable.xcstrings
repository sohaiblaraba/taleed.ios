    "settings_verification_ai_consent_title": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification automatique par OpenAI"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic check by OpenAI"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحقق الآلي عبر OpenAI"
          }
        }
      }
    },
    "settings_verification_ai_consent_body": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour accélérer l’examen, Taleed peut envoyer la photo de votre pièce d’identité et le nom de votre compte à OpenAI, un service d’intelligence artificielle, pour une première vérification automatique. Elle peut accepter votre demande, jamais la refuser : notre équipe examine tous les autres cas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To speed up the review, Taleed can send the photo of your ID and the name on your account to OpenAI, an artificial intelligence service, for an automatic first check. It can approve your request, never refuse it: our team reviews every other case."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتسريع المراجعة، يمكن لـ Taleed إرسال صورة وثيقة هويتك واسم حسابك إلى OpenAI، وهي خدمة ذكاء اصطناعي، لإجراء تحقق أولي آلي. يمكن لهذا التحقق قبول طلبك ولا يرفضه أبدًا: يراجع فريقنا جميع الحالات الأخرى."
          }
        }
      }
    },
    "settings_verification_ai_consent_agree": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepter et continuer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agree and continue"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموافقة والمتابعة"
          }
        }
      }
    },
    "settings_verification_ai_consent_decline": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer sans vérification automatique"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue without automatic check"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المتابعة دون تحقق آلي"
          }
        }
      }
    },
    "settings_verification_ai_consent_decline_hint": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notre équipe examine alors votre pièce d’identité manuellement. C’est plus long."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Our team then checks your ID by hand. This takes longer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيراجع فريقنا وثيقتك يدويًا، وهذا يستغرق وقتًا أطول."
          }
        }
      }
    },
    "visual_consent_title": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche par photo avec Jina AI"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo search by Jina AI"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البحث بالصورة عبر Jina AI"
          }
        }
      }
    },
    "visual_consent_body": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour trouver des annonces similaires, Taleed envoie votre photo à Jina AI, un service d’intelligence artificielle. Aucune donnée de votre compte n’est envoyée avec elle. Nous supprimons la photo de nos serveurs après 24 heures."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To find similar listings, Taleed sends your photo to Jina AI, an artificial intelligence service. No data from your account is sent with it. We delete the photo from our servers after 24 hours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للعثور على إعلانات مشابهة، ترسل Taleed صورتك إلى Jina AI، وهي خدمة ذكاء اصطناعي. لا تُرسل معها أي بيانات من حسابك. نحذف الصورة من خوادمنا بعد 24 ساعة."
          }
        }
      }
    },
    "visual_consent_agree": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agree"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موافق"
          }
        }
      }
    },
    "visual_consent_cancel": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء"
          }
        }
      }
    },
    "app_settings_analytics": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشاركة إحصاءات الاستخدام"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share usage statistics"
          }
