    "settings_email_change_sent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إرسال رابط التأكيد إلى %@. يصبح التغيير نافذًا بمجرد النقر على الرابط."
          }
        },
        "en": {
