    "app_checkout_pending_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا أتممت الدفع، سيتم تأكيد طلبك بعد لحظات. اسحب للتحديث للتحقق."
          }
