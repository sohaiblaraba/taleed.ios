    "settings_name_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدمان للتحقق من الهوية ولطرودك. لا يراهما الأعضاء الآخرون أبدًا: على تليد تظهر باسم المستخدم الخاص بك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for identity verification and your parcels. Other members never see it — on Taleed you appear as your username."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Servent à la vérification d’identité et à vos colis. Les autres membres ne les voient jamais : sur Taleed, vous apparaissez sous votre nom d’utilisateur."
          }
        }
      }
    },
    "settings_username_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Username"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom d’utilisateur"
          }
        }
      }
    },
    "settings_username_change_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هكذا يراك الأعضاء: في ملفك الشخصي وعلى منتجاتك وفي المحادثات. تبقى الروابط إلى اسمك القديم صالحة، ولا يمكن لأي شخص آخر أخذه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is how members see you — on your profile, your items and in chat. Links to your old username keep working, and nobody else can take it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est ainsi que les membres vous voient : sur votre profil, vos articles et dans la messagerie. Les liens vers votre ancien nom continuent de fonctionner, et personne d’autre ne peut le reprendre."
          }
        }
      }
    },
    "settings_username_rule_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من 3 إلى 30 حرفًا: أحرف وأرقام ونقاط وشرطات وشرطات سفلية. يُعرض دائمًا بأحرف صغيرة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3 to 30 characters: letters, numbers, dots, dashes and underscores. Always shown in lowercase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 à 30 caractères : lettres, chiffres, points, tirets et tirets bas. Toujours affiché en minuscules."
          }
        }
      }
    },
