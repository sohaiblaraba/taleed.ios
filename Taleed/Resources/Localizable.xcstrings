    "auth_social_error_rate_limited": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة جدًا. انتظر بضع دقائق ثم حاول مجددًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Wait a few minutes, then try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives. Patientez quelques minutes, puis réessayez."
          }
        }
      }
    },
    "settings_password_none_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجّل الدخول باستخدام Google أو Apple. لتتمكّن أيضًا من تسجيل الدخول بكلمة مرور، عيّن واحدة: سنرسل لك رابطًا عبر البريد الإلكتروني."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You log in with Google or Apple. To also log in with a password, set one: we email you a link."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous connectez avec Google ou Apple. Pour pouvoir aussi vous connecter avec un mot de passe, définissez-en un : nous vous envoyons un lien par email."
          }
        }
      }
    },
    "settings_password_none_cta": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيين كلمة مرور"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a password"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définir un mot de passe"
          }
        }
      }
    },
    "app_auth_social_email_taken_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع مجددًا باستخدام Google أو Apple لتسجيل الدخول إليه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with Google or Apple again to log in to it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez à nouveau avec Google ou Apple pour vous y connecter."
          }
        }
      }
    },
    "auth_social_error_link_forbidden": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل هذا الحساب الدخول بكلمة المرور فقط. سجّل الدخول ببريدك الإلكتروني وكلمة المرور."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account logs in with its password only. Log in with your email and password."
          }
        },
        "fr": {
