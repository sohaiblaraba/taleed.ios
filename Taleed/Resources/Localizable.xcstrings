    "settings_email_verify_first_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق أولًا من بريدك الإلكتروني الحالي: افتح الرابط الذي أرسلناه إليك."
          }
        },
        "en": {
