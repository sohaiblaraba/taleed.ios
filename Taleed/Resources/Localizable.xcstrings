    "referrals_gate_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتجنب إساءة الاستخدام، يمكن فقط للأعضاء الذين تم التحقق من هويتهم دعوة الأصدقاء. يستغرق التحقق بضع دقائق."
          }
