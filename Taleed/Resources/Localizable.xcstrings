    "app_profile_block_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتمكّن أيٌّ منكما من مراسلة الآخر أو تقديم عروض له أو شراء أغراضه بالحزمة أو متابعته، وتنتهي المتابعات بينكما. تبقى محادثاتكما مقروءة ويمكنك دائمًا الإبلاغ عن هذا العضو."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither of you will be able to message the other, make offers, bundle the other’s items or follow each other, and any follows between you end. Your conversations stay readable and you can still report this member."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pourrez plus vous écrire, vous faire d’offres, acheter vos articles en lot ni vous suivre, et vos abonnements mutuels prennent fin. Vos conversations restent lisibles et vous pouvez toujours signaler ce membre."
          }
        }
      }
    },
