    "settings_delete_blocked_active_orders": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك طلبات جارية. أكملها أو ألغها قبل حذف حسابك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have orders in progress. Complete or cancel them before deleting your account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez des commandes en cours. Terminez-les ou annulez-les avant de supprimer votre compte."
          }
        }
      }
    },
    "settings_delete_blocked_open_disputes": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك نزاع مفتوح. انتظر حلّه قبل حذف حسابك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have an open dispute. Wait for its resolution before deleting your account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez un litige en cours. Attendez sa résolution avant de supprimer votre compte."
          }
        }
      }
    },
    "settings_delete_blocked_pending_payout": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك تحويل قيد المعالجة. انتظر وصوله قبل حذف حسابك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A payout is being processed. Wait for it to arrive before deleting your account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un versement est en cours de traitement. Attendez son arrivée avant de supprimer votre compte."
          }
        }
      }
    },
    "settings_delete_blocked_wallet": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال لديك رصيد في محفظتك. اطلب تحويله قبل حذف حسابك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You still have money in your wallet. Request a payout before deleting your account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste de l’argent sur votre portefeuille. Demandez un versement avant de supprimer votre compte."
          }
        }
      }
    },
