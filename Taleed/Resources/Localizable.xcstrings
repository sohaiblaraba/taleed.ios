    "app_edit_listing_reloaded": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عُدّل هذا الإعلان من مكان آخر وأُعيد تحميل صوره. تحقّق منها ثم احفظ من جديد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This listing was changed somewhere else and its photos were reloaded. Check them, then save again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette annonce a été modifiée ailleurs. Ses photos ont été rechargées : vérifiez-les, puis enregistrez à nouveau."
          }
        }
      }
    },
    "app_error_address_limit": {
      "extractionState": "manual",
      "localizations": {
