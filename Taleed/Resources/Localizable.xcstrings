    "app_order_cancel_body": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les articles sont remis en vente. Ce que vous avez déjà réglé sur Taleed vous est reversé avec le prochain versement hebdomadaire."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعاد الأغراض إلى البيع، ويُدفع لك ما سبق أن دفعته على Taleed مع الدفعة الأسبوعية القادمة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The items go back on sale. What you already paid on Taleed is paid back to you with the next weekly payout."
          }
        }
      }
    },
    "app_order_seller_ships_by": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على البائع إرسال الطرد قبل %@، وإلا سيُرد إليك المبلغ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The seller must ship before %@, or you will be refunded."
