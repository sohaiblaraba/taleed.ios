    "auth_social_error_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تسجيل الدخول. حاول مجددًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in did not go through. Please try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion n’a pas abouti. Réessayez."
          }
        }
      }
    },
    "auth_social_error_email_unverified": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يملك حساب Google أو Apple هذا بريدًا إلكترونيًا موثّقًا. سجّل الدخول ببريدك الإلكتروني وكلمة المرور."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Google or Apple account has no verified email address. Log in with your email and password instead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte Google ou Apple n’a pas d’adresse email vérifiée. Connectez-vous avec votre email et votre mot de passe."
          }
        }
      }
    },
    "auth_social_error_invite_required": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تليد متاح بالدعوة فقط حاليًا. اطلب الوصول، ثم تابع باستخدام Google أو Apple بنفس البريد الإلكتروني."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taleed is invite-only for now. Request access, then continue with Google or Apple using the same email."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taleed est sur invitation pour le moment. Demandez l’accès, puis continuez avec Google ou Apple avec le même email."
          }
        }
      }
    },
    "auth_social_error_refused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إنشاء هذا الحساب."
