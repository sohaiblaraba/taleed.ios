    "app_error_address_limit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد بلغت الحد الأقصى لعدد العناوين. احذف عنوانًا لإضافة آخر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have reached the maximum number of addresses. Delete one to add another."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint le nombre maximal d’adresses. Supprimez-en une pour en ajouter une autre."
          }
        }
      }
    },
    "app_error_file_too_large": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الصورة كبيرة جدًا."
