// Debug: the local backend over plain HTTP (simulator only).
#include "Base.xcconfig"

// One bundle ID in every configuration (decision FB-2): the Google iOS client and Sign in with Apple are tied to
// app.taleed.mobile, so the Debug app replaces the Release and Staging apps on a device or simulator.
PRODUCT_BUNDLE_IDENTIFIER = app.taleed.mobile
APP_DISPLAY_NAME = Taleed Dev
TALEED_API_BASE_URL = http:/$()/localhost:3000/api/v1

// Crash reports stay on the simulator or device (Crashlytics collection off).
TALEED_CRASH_REPORTING = NO
// No usage statistics from local builds.
TALEED_ANALYTICS = NO
TALEED_BUILD_TYPE = debug

// Info.plist is preprocessed: TALEED_ALLOWS_LOCAL_NETWORKING turns on NSAllowsLocalNetworking.
INFOPLIST_PREPROCESSOR_DEFINITIONS = TALEED_ALLOWS_LOCAL_NETWORKING=1

// Local settings that are not in git, such as TALEED_FIREBASE_CONFIG_DIR. Optional.
#include? "Local.xcconfig"
