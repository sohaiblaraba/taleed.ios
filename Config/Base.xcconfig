// Settings shared by every configuration. Each configuration file includes this one.

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// Release identity. Debug overrides it.
PRODUCT_BUNDLE_IDENTIFIER = app.taleed
APP_DISPLAY_NAME = Taleed

// The base URL of the API. "/$()/" keeps "//" from starting a comment.
TALEED_API_BASE_URL = https:/$()/taleed.app/api/v1

// The URL scheme payment pages return to (`taleed://payment-return`). The server's MOBILE_URL_SCHEME
// must match: `taleed` in production and locally; a staging build would use its own.
TALEED_URL_SCHEME = taleed

// The app's Apple ID in App Store Connect (digits only, such as 6450000000). The blocking update screen
// opens https://apps.apple.com/app/id<ID>. Empty until the App Store record exists: the screen then
// opens the website (`GET /config` links.website) instead.
TALEED_APP_STORE_ID =
