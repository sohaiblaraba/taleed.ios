// Settings shared by every configuration. Each configuration file includes this one.

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// Release identity. Debug overrides it.
PRODUCT_BUNDLE_IDENTIFIER = app.taleed.mobile
APP_DISPLAY_NAME = Taleed

// The base URL of the API. "/$()/" keeps "//" from starting a comment.
TALEED_API_BASE_URL = https:/$()/taleed.app/api/v1

// The website host whose links open the app (Associated Domains in Taleed.entitlements: applinks and
// webcredentials, slice-d.md "App links"; LinkRouter.websiteHosts). Staging sets dev.taleed.app. The host
// serves /.well-known/apple-app-site-association with this app's team and bundle identifiers.
TALEED_APP_LINK_HOST = taleed.app

// The URL scheme payment pages return to (`taleed://payment-return`). The server's MOBILE_URL_SCHEME
// must match: `taleed` in production, locally and on dev.taleed.app (Staging).
TALEED_URL_SCHEME = taleed

// The app's Apple ID in App Store Connect (digits only, such as 6450000000). The blocking update screen
// opens https://apps.apple.com/app/id<ID>. Empty until the App Store record exists: the screen then
// opens the website (`GET /config` links.website) instead.
TALEED_APP_STORE_ID =

// Sign in with Google (slice G, The client IDs): the iOS OAuth client of Taleed's Google Cloud project, for the
// bundle ID app.taleed.mobile, and its reversed form, the URL scheme Google's sign-in page returns to. They are
// not secrets. The server's GOOGLE_IOS_CLIENT_IDS must list the client ID, or `GET /config` hides the button. A
// configuration whose environment has another client sets both. Empty: the app shows no Google button.
GOOGLE_IOS_CLIENT_ID = 406327415556-9o6ic1tk0mtkdkoqpbjphfhno35djdul.apps.googleusercontent.com
GOOGLE_IOS_URL_SCHEME = com.googleusercontent.apps.406327415556-9o6ic1tk0mtkdkoqpbjphfhno35djdul
